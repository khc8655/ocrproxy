# Sample environment for ocrproxy-edgeone-relay
#
# Copy to .env, fill in, then push with:
#   edgeone makers env pull -f .env
# Or set in the Makers console UI: Project → Settings → Environment Variables

# Bearer token clients must send.  Use a long random string.
PROXY_API_KEY=replace-me-with-a-long-random-token

# JSON config matching VM's `proxy_config.enc` (only providers + agent_models needed).
# See FEASIBILITY-REPORT.md §3.3 for the shape.
#
# Tip: extract this from the VM with:
#   sudo -u ocrproxy /opt/ocrproxy/venv/bin/python -c "
#   from app.config_store import get_config
#   import asyncio, json
#   c = asyncio.run(get_config())
#   print(json.dumps({k: c[k] for k in ('providers', 'agent_models') if k in c}))"
AGENT_CONFIG_JSON={"providers":{"siliconflow":{"base_url":"https://api.siliconflow.cn","keys":{"KeyA":"sk-REPLACE"}},"sensenova":{"base_url":"https://api.sensenova.cn","keys":{"self":"sk-REPLACE"}}},"agent_models":{"deepseek-v4-flash":{"keys":[{"provider":"sensenova","key":"self","upstream_model":"DeepSeek-V3-Flash"}]}}}

# Upstream read timeout in ms.  Default 60000 (60s).  Bump for slow models.
# UPSTREAM_TIMEOUT_MS=90000

# When body > 1 MB, the V8 path returns 413.  This URL is advertised in
# the X-Fallback-Endpoint header so clients can retry the long-context
# path.  Point at the Cloud Function or the VM endpoint.
# EDGEONE_FALLBACK_URL=https://agent-long.<your-domain>/v1/chat/completions
