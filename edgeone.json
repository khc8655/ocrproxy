{
  "name": "ocrproxy-agent-edgeone",
  "buildCommand": "cd agent-edgeone && npm run build:admin",
  "installCommand": "cd agent-edgeone && npm install",
  "outputDirectory": "agent-edgeone",
  "nodeVersion": "20.18.0",
  "build": {
    "edgeFunctions": "agent-edgeone/edge-functions",
    "cloudFunctions": "agent-edgeone/cloud-functions"
  },
  "functions": {
    "edge": {
      "memory": 128,
      "executionTimeout": 30000
    },
    "cloud": {
      "memory": 256,
      "executionTimeout": 120000,
      "regions": ["ap-guangzhou", "ap-shanghai", "ap-beijing"]
    }
  },
  "headers": [
    {
      "source": "/(api|v1)(/.*)?",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "X-Accel-Buffering", "value": "no" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "*" }
      ]
    },
    {
      "source": "/(admin|.*\\.html)?",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ],
  "kv": {
    "agent_kv": {
      "description": "Stores the live agent_models + providers config. Optional; env var AGENT_CONFIG_JSON is the fallback when KV is empty."
    }
  },
  "env": {
    "PROXY_API_KEY": {
      "description": "Bearer token clients must send on /v1/* endpoints.",
      "secret": true
    },
    "ADMIN_PASSWORD": {
      "description": "Admin password required to log into /admin management console.",
      "secret": true
    },
    "AGENT_CONFIG_JSON": {
      "description": "JSON string with shape { providers, agent_models }. Read on cold start; KV key 'config' takes precedence.",
      "secret": false
    },
    "UPSTREAM_TIMEOUT_MS": {
      "description": "Read timeout when calling upstream LLM providers. Default 30000.",
      "secret": false
    },
    "EDGEONE_FALLBACK_URL": {
      "description": "Optional. When body > 1MB, returned in X-Fallback-Endpoint header. Point at the Cloud Function or VM endpoint.",
      "secret": false
    }
  },
  "routes": [
    {
      "src": "^/(api|v1|admin|health|check-ip)(/.*)?$",
      "handler": "edge"
    },
    {
      "src": "^/?$",
      "handler": "edge"
    }
  ]
}
