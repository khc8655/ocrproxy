{
  "version": 2,
  "groups": [
    {
      "id": "auth",
      "title": "客户端鉴权与运行模式"
    },
    {
      "id": "routing",
      "title": "路由与负载均衡策略"
    },
    {
      "id": "timeout",
      "title": "超时与预算控制"
    },
    {
      "id": "fault",
      "title": "容错、熔断与冷却"
    },
    {
      "id": "concurrency",
      "title": "并发与队列控制"
    }
  ],
  "fields": [
    {
      "key": "proxy_api_key",
      "group": "auth",
      "label": "客户端调用 API Key",
      "hint": "外部应用访问 /v1/chat/completions 或 /v1/embeddings 等生产路由时所带的 Bearer Token",
      "type": "string",
      "placeholder": "留空则使用管理员密码作为客户端 Key",
      "modes": [
        "agent",
        "kb"
      ],
      "hosts": [
        "vm",
        "edgeone"
      ]
    },
    {
      "key": "mode_schedule_enabled",
      "group": "auth",
      "label": "按时段自动切换运行模式",
      "hint": "开启后在 KB 时段自动切到 KB，其余时间切回 Agent（北京时间）。每个时段只切一次，时段内手动切换会保留；切回 Agent 最多等 KB 空闲 1 小时，切入 KB 最多等 15 分钟",
      "type": "boolean",
      "default": false,
      "modes": [
        "agent",
        "kb"
      ],
      "hosts": [
        "vm"
      ]
    },
    {
      "key": "mode_schedule_kb_start",
      "group": "auth",
      "label": "KB 时段开始 (HH:MM)",
      "hint": "建议比夜间入库任务早几分钟",
      "type": "string",
      "default": "22:00",
      "modes": [
        "agent",
        "kb"
      ],
      "hosts": [
        "vm"
      ]
    },
    {
      "key": "mode_schedule_kb_end",
      "group": "auth",
      "label": "KB 时段结束 (HH:MM)",
      "hint": "到点后等 KB 空闲 5 分钟再切回 Agent；最多顺延 1 小时",
      "type": "string",
      "default": "08:00",
      "modes": [
        "agent",
        "kb"
      ],
      "hosts": [
        "vm"
      ]
    },
    {
      "key": "agent_routing_strategy",
      "group": "routing",
      "label": "智能体 Key 调度策略",
      "hint": "sticky_failover 固定当前 Key，遇 429/鉴权/配额故障自动顺延；manual 锁定当前激活 Key，不重试不切换（调度器仅支持这两种，旧值自动回落为 sticky_failover）",
      "type": "select",
      "default": "sticky_failover",
      "options": [
        {
          "value": "sticky_failover",
          "label": "粘性会话与智能故障转移 (推荐)"
        },
        {
          "value": "manual",
          "label": "手动严格直通 (不重试)"
        }
      ],
      "modes": [
        "agent"
      ],
      "hosts": [
        "vm",
        "edgeone"
      ]
    },
    {
      "key": "kb_routing_strategy",
      "group": "routing",
      "label": "KB 知识库调度策略",
      "hint": "round_robin 轮询所有 Key 平摊并发（推荐）；manual 锁定第一个候选、不切换，仅调试用",
      "type": "select",
      "default": "round_robin",
      "options": [
        {
          "value": "round_robin",
          "label": "标准轮询 (Round Robin)"
        },
        {
          "value": "manual",
          "label": "纯手动直通调试 (manual)"
        }
      ],
      "modes": [
        "kb"
      ],
      "hosts": [
        "vm"
      ]
    },
    {
      "key": "agent_first_byte_timeout_sec",
      "group": "timeout",
      "label": "智能体首字节等待超时",
      "hint": "稳定模式下单个 Key 等待首字节的上限，超时换下一个 Key；整单固定 300s 封顶，90s 约可尝试 3 个 Key。手动直通模式不使用此值（固定 300s）",
      "type": "int",
      "unit": "s",
      "default": 90,
      "min": 5,
      "max": 600,
      "modes": [
        "agent"
      ],
      "hosts": [
        "vm",
        "edgeone"
      ],
      "strategies": [
        "sticky_failover"
      ]
    },
    {
      "key": "kb_chat_timeout_sec",
      "group": "timeout",
      "label": "KB Chat 单次超时",
      "hint": "KB 模式 Chat（关键词抽取、摘要等）每个 Key 单次等待上限；免费模型非流式生成较慢，建议 ≥ 60s",
      "type": "int",
      "unit": "s",
      "default": 60,
      "min": 10,
      "max": 300,
      "modes": [
        "kb"
      ],
      "hosts": [
        "vm"
      ]
    },
    {
      "key": "upstream_timeout_sec",
      "group": "timeout",
      "label": "Embedding / Rerank 单次超时",
      "hint": "KB 模式 Embedding、Rerank 每个 Key 单次等待上限，超时换下一个 Key",
      "type": "int",
      "unit": "s",
      "default": 20,
      "min": 5,
      "max": 300,
      "modes": [
        "kb"
      ],
      "hosts": [
        "vm"
      ],
      "aliases": [
        "upstream_timeout",
        "chat_fast_timeout",
        "upstream_timeout_embedding",
        "upstream_timeout_rerank"
      ]
    },
    {
      "key": "upstream_timeout_kb",
      "group": "timeout",
      "label": "OCR 单次超时",
      "hint": "处理大图 OCR 或高延迟批处理任务的单次等待超时",
      "type": "int",
      "unit": "s",
      "default": 60,
      "min": 10,
      "max": 300,
      "modes": [
        "kb"
      ],
      "hosts": [
        "vm"
      ],
      "aliases": [
        "upstream_timeout_ocr"
      ]
    },
    {
      "key": "cooldown_429_sec",
      "group": "fault",
      "label": "429 速率超限临时冷却",
      "hint": "KB：某个 Key 遇到 429（RPM/TPM 超限）后暂停的秒数，期间请求轮到其他 Key；上游给了 Retry-After 时以其为准（最多 300s）",
      "type": "int",
      "unit": "s",
      "default": 60,
      "min": 5,
      "max": 600,
      "modes": [
        "kb"
      ],
      "hosts": [
        "vm"
      ],
      "aliases": [
        "cooldown_tpm_sec"
      ]
    },
    {
      "key": "cooldown_5xx_sec",
      "group": "fault",
      "label": "5xx 服务端错误冷却",
      "hint": "KB：单次 5xx 后该 Key 暂停的秒数（未达熔断阈值时）",
      "type": "int",
      "unit": "s",
      "default": 30,
      "min": 5,
      "max": 300,
      "modes": [
        "kb"
      ],
      "hosts": [
        "vm"
      ],
      "aliases": [
        "cooldown_duration"
      ]
    },
    {
      "key": "circuit_break_threshold",
      "group": "fault",
      "label": "连续熔断阈值",
      "hint": "KB：同一个 Key 连续多少次 5xx 后熔断",
      "type": "int",
      "default": 3,
      "min": 1,
      "max": 10,
      "modes": [
        "kb"
      ],
      "hosts": [
        "vm"
      ]
    },
    {
      "key": "circuit_cooldown_sec",
      "group": "fault",
      "label": "熔断后恢复探活周期",
      "hint": "KB：熔断后该 Key 暂停的秒数（单一参数，不再与升级冷却取最大值）",
      "type": "int",
      "unit": "s",
      "default": 600,
      "min": 5,
      "max": 7200,
      "modes": [
        "kb"
      ],
      "hosts": [
        "vm"
      ]
    },
    {
      "key": "kb_max_concurrency_per_key",
      "group": "concurrency",
      "label": "KB 单 Key 最大并发",
      "hint": "KB：单个 Key 同时在途请求上限。Key 多时调小能把负载摊到所有 Key（免费 Key 单个 RPM 低），默认 4",
      "type": "int",
      "default": 4,
      "min": 1,
      "max": 100,
      "modes": [
        "kb"
      ],
      "hosts": [
        "vm"
      ]
    },
    {
      "key": "agent_max_concurrency_per_key",
      "group": "concurrency",
      "label": "Agent 单 Key 最大并发",
      "hint": "0 = 不限（默认）。设限后粘性 Key 繁忙时会话会被分流到其他 Key，导致上游提示词缓存失效",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 1000,
      "modes": [
        "agent"
      ],
      "hosts": [
        "vm"
      ],
      "strategies": [
        "sticky_failover"
      ]
    },
    {
      "key": "ocr_max_inflight",
      "group": "concurrency",
      "label": "OCR 全局在途内存并发上限",
      "hint": "防止并发大图 Base64 导致内存爆满，严格限制同时执行的 OCR 请求数",
      "type": "int",
      "default": 12,
      "min": 1,
      "max": 30,
      "modes": [
        "kb"
      ],
      "hosts": [
        "vm"
      ]
    },
    {
      "key": "ocr_queue_timeout_sec",
      "group": "concurrency",
      "label": "OCR 排队超时等待秒数",
      "hint": "超出 OCR 在途并发时，请求在内存队列中等待的最大秒数；设为 0 表示不排队立即 429",
      "type": "int",
      "unit": "s",
      "default": 30,
      "min": 0,
      "max": 300,
      "modes": [
        "kb"
      ],
      "hosts": [
        "vm"
      ]
    },
    {
      "key": "cooldown_quota_sec",
      "group": "fault",
      "label": "冷宫时长（欠费 / Key 失效 / 封禁）",
      "hint": "遇到 402、余额不足/欠费、401 Key 无效、403 封禁或无权访问该模型时，该 Key 停用的时长（默认 24h，最长 7 天）。VM 落盘，重启不丢；在模型列表手动测试该 Key 成功会立即解除",
      "type": "int",
      "default": 86400,
      "min": 600,
      "max": 604800,
      "modes": [
        "agent",
        "kb"
      ],
      "hosts": [
        "vm",
        "edgeone"
      ],
      "strategies": [
        "sticky_failover",
        "round_robin"
      ],
      "unit": "s"
    },
    {
      "key": "kb_global_max_concurrency",
      "group": "concurrency",
      "label": "KB 全局最大并发",
      "hint": "KB 模式全节点/全 Key 的总并发上限",
      "type": "int",
      "default": 30,
      "min": 1,
      "max": 500,
      "modes": [
        "kb"
      ],
      "hosts": [
        "vm"
      ]
    },
    {
      "key": "stream_precommit_grace_sec",
      "group": "timeout",
      "label": "流式首包前静默上限",
      "hint": "流式请求在上游首包前最多静默多少秒（期间仍可换 Key），超过后先回 200 + 心跳。需小于前置代理空闲超时（Nginx 默认 60s）（内部常量，不在设置页显示）",
      "type": "int",
      "unit": "s",
      "default": 45,
      "min": 1,
      "max": 120,
      "modes": [
        "agent"
      ],
      "hosts": [
        "vm"
      ],
      "hidden": true
    },
    {
      "key": "edge_peek_window_sec",
      "group": "timeout",
      "label": "流式首包前静默上限",
      "hint": "流式请求在上游首包前最多静默多少秒（期间仍可换 Key），超过后先回 200 + 心跳。EdgeOne 与客户端空闲上限约 25s（内部常量，不在设置页显示）",
      "type": "int",
      "unit": "s",
      "default": 20,
      "min": 3,
      "max": 24,
      "modes": [
        "agent"
      ],
      "hosts": [
        "edgeone"
      ],
      "hidden": true
    },
    {
      "key": "cooldown_404_sec",
      "group": "fault",
      "label": "404 冷却 (秒)",
      "hint": "供应商 404 时的候选 Key 冷却时长（内部常量，不在设置页显示）",
      "type": "int",
      "default": 600,
      "min": 0,
      "max": 3600,
      "modes": [
        "agent",
        "kb"
      ],
      "hosts": [
        "vm"
      ],
      "hidden": true
    },
    {
      "key": "cooldown_410_sec",
      "group": "fault",
      "label": "410 模型下线冷却 (秒)",
      "hint": "上游返回 410（模型已下线）时该模型在所有 Key 上的冷却时长（内部常量，不在设置页显示）",
      "type": "int",
      "default": 86400,
      "min": 60,
      "max": 259200,
      "modes": [
        "agent",
        "kb"
      ],
      "hosts": [
        "vm"
      ],
      "hidden": true
    }
  ]
}
