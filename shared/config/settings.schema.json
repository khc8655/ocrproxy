{
  "version": 1,
  "groups": [
    {
      "id": "auth",
      "title": "客户端鉴权与运行模式"
    },
    {
      "id": "routing",
      "title": "路由与负载均衡策略"
    },
    {
      "id": "timeout",
      "title": "超时与预算控制"
    },
    {
      "id": "fault",
      "title": "容错、熔断与冷却"
    },
    {
      "id": "concurrency",
      "title": "并发与队列控制"
    }
  ],
  "fields": [
    {
      "key": "proxy_api_key",
      "group": "auth",
      "label": "客户端调用 API Key",
      "hint": "外部应用访问 /v1/chat/completions 或 /v1/embeddings 等生产路由时所带的 Bearer Token",
      "type": "string",
      "placeholder": "留空则使用管理员密码作为客户端 Key",
      "modes": [
        "agent",
        "kb"
      ],
      "hosts": [
        "vm",
        "edgeone"
      ]
    },
    {
      "key": "agent_routing_strategy",
      "group": "routing",
      "label": "智能体 Key 调度策略",
      "hint": "sticky_failover 固定当前 Key，遇 429/鉴权/配额故障自动顺延；manual 锁定当前激活 Key，不重试不切换（调度器仅支持这两种，旧值自动回落为 sticky_failover）",
      "type": "select",
      "default": "sticky_failover",
      "options": [
        {
          "value": "sticky_failover",
          "label": "粘性会话与智能故障转移 (推荐)"
        },
        {
          "value": "manual",
          "label": "手动严格直通 (不重试)"
        }
      ],
      "modes": [
        "agent"
      ],
      "hosts": [
        "vm",
        "edgeone"
      ]
    },
    {
      "key": "kb_routing_strategy",
      "group": "routing",
      "label": "KB 知识库调度策略",
      "hint": "round_robin 轮询负载；weighted 加权路由；latency_first 最低延迟优先",
      "type": "select",
      "default": "round_robin",
      "options": [
        {
          "value": "round_robin",
          "label": "标准轮询 (Round Robin)"
        },
        {
          "value": "weighted",
          "label": "性能与配额加权轮询"
        },
        {
          "value": "latency_first",
          "label": "最低延迟优先"
        }
      ],
      "modes": [
        "kb"
      ],
      "hosts": [
        "vm"
      ]
    },
    {
      "key": "agent_first_byte_timeout_sec",
      "group": "timeout",
      "label": "智能体首字节等待超时",
      "hint": "单次尝试等待首字节的最长秒数。支持长思考/推理模型（如 DeepSeek-R1、Claude 3.7），建议 ≥ 120s",
      "type": "int",
      "unit": "s",
      "default": 120,
      "min": 5,
      "max": 600,
      "modes": [
        "agent"
      ],
      "hosts": [
        "vm",
        "edgeone"
      ]
    },
    {
      "key": "stream_precommit_grace_sec",
      "group": "timeout",
      "label": "流式首包前静默上限",
      "hint": "流式请求在上游首包前最多静默多少秒（期间仍可换 Key），超过后先回 200 + 心跳。需小于前置代理空闲超时（Nginx 默认 60s）",
      "type": "int",
      "unit": "s",
      "default": 45,
      "min": 1,
      "max": 120,
      "modes": [
        "agent"
      ],
      "hosts": [
        "vm"
      ]
    },
    {
      "key": "edge_peek_window_sec",
      "group": "timeout",
      "label": "流式首包前静默上限",
      "hint": "流式请求在上游首包前最多静默多少秒（期间仍可换 Key），超过后先回 200 + 心跳。EdgeOne 与客户端空闲上限约 25s",
      "type": "int",
      "unit": "s",
      "default": 20,
      "min": 3,
      "max": 24,
      "modes": [
        "agent"
      ],
      "hosts": [
        "edgeone"
      ]
    },
    {
      "key": "upstream_timeout_sec",
      "group": "timeout",
      "label": "知识库常规请求单次超时",
      "hint": "KB 模式下 Chat/Embedding/Rerank 等常规轻量接口的单次等待超时",
      "type": "int",
      "unit": "s",
      "default": 15,
      "min": 5,
      "max": 300,
      "modes": [
        "kb"
      ],
      "hosts": [
        "vm"
      ],
      "aliases": [
        "upstream_timeout",
        "chat_fast_timeout",
        "upstream_timeout_embedding",
        "upstream_timeout_rerank"
      ]
    },
    {
      "key": "upstream_timeout_kb",
      "group": "timeout",
      "label": "OCR / 异步耗时任务超时",
      "hint": "处理大图 OCR 或高延迟批处理任务的单次等待超时",
      "type": "int",
      "unit": "s",
      "default": 60,
      "min": 10,
      "max": 300,
      "modes": [
        "kb"
      ],
      "hosts": [
        "vm"
      ],
      "aliases": [
        "upstream_timeout_ocr"
      ]
    },
    {
      "key": "request_total_budget_sec",
      "group": "timeout",
      "label": "单请求全局总预算 (可选)",
      "hint": "所有故障转移与重试累计耗时的最终截止预算。留空时系统将按 [单次超时 × 重试次数] 自动计算",
      "type": "int",
      "unit": "s",
      "default": 300,
      "min": 10,
      "max": 900,
      "optional": true,
      "modes": [
        "agent",
        "kb"
      ],
      "hosts": [
        "vm",
        "edgeone"
      ],
      "aliases": [
        "schedule_total_budget"
      ]
    },
    {
      "key": "max_retries",
      "group": "fault",
      "label": "单请求最大重试次数",
      "hint": "单个用户请求在上游异常时允许轮换尝试不同 Key 的最大次数",
      "type": "int",
      "default": 3,
      "min": 1,
      "max": 10,
      "modes": [
        "agent",
        "kb"
      ],
      "hosts": [
        "vm",
        "edgeone"
      ],
      "aliases": [
        "schedule_total_budget_count"
      ]
    },
    {
      "key": "max_attempts_per_provider",
      "group": "fault",
      "label": "单个供应商最多尝试 Key 数",
      "hint": "同一次请求内，单个供应商最多换几个不同的 Key（换 Key 次数，不是重试次数）",
      "type": "int",
      "default": 3,
      "min": 1,
      "max": 10,
      "modes": [
        "agent",
        "kb"
      ],
      "hosts": [
        "vm",
        "edgeone"
      ]
    },
    {
      "key": "fast_failover_provider_down",
      "group": "fault",
      "label": "供应商宕机快速跳过 (502/504/网络超时)",
      "hint": "当同一供应商名下有 Key 遭遇 502/504 或连接超时时，若配置了其他可用厂商，立即跳往下一厂商而不是重试本厂商其他 Key",
      "type": "boolean",
      "default": true,
      "modes": [
        "agent",
        "kb"
      ],
      "hosts": [
        "vm",
        "edgeone"
      ]
    },
    {
      "key": "cooldown_429_sec",
      "group": "fault",
      "label": "429 速率超限临时冷却",
      "hint": "遭遇上游 429 Too Many Requests (TPM/RPM 超限) 时，将该 Key 移入冷却队列的秒数",
      "type": "int",
      "unit": "s",
      "default": 60,
      "min": 5,
      "max": 600,
      "modes": [
        "agent",
        "kb"
      ],
      "hosts": [
        "vm",
        "edgeone"
      ],
      "aliases": [
        "cooldown_tpm_sec"
      ]
    },
    {
      "key": "cooldown_5xx_sec",
      "group": "fault",
      "label": "5xx 服务端错误冷却",
      "hint": "上游返回 500/502/503/504 错误时的临时封锁秒数",
      "type": "int",
      "unit": "s",
      "default": 30,
      "min": 5,
      "max": 300,
      "modes": [
        "agent",
        "kb"
      ],
      "hosts": [
        "vm",
        "edgeone"
      ],
      "aliases": [
        "cooldown_duration"
      ]
    },
    {
      "key": "cooldown_403_sec",
      "group": "fault",
      "label": "403/额度耗尽冷却",
      "hint": "上游提示额度不足、欠费或账户封禁时的冷却秒数",
      "type": "int",
      "unit": "s",
      "default": 600,
      "min": 10,
      "max": 3600,
      "modes": [
        "agent",
        "kb"
      ],
      "hosts": [
        "vm",
        "edgeone"
      ]
    },
    {
      "key": "circuit_break_threshold",
      "group": "fault",
      "label": "连续熔断阈值",
      "hint": "连续遭遇多少次失败后触发该 Key 的熔断隔离",
      "type": "int",
      "default": 3,
      "min": 1,
      "max": 10,
      "modes": [
        "agent",
        "kb"
      ],
      "hosts": [
        "vm",
        "edgeone"
      ]
    },
    {
      "key": "circuit_cooldown_sec",
      "group": "fault",
      "label": "熔断后恢复探活周期",
      "hint": "Key 触发熔断后保持隔离的秒数，过期后自动进入半开状态试探",
      "type": "int",
      "unit": "s",
      "default": 300,
      "min": 5,
      "max": 600,
      "modes": [
        "agent",
        "kb"
      ],
      "hosts": [
        "vm",
        "edgeone"
      ]
    },
    {
      "key": "kb_max_concurrency_per_key",
      "group": "concurrency",
      "label": "KB 单 Key 最大并发",
      "hint": "KB 模式单个 Key 的在途并发上限，超出则短暂排队或调度至其他候选 Key",
      "type": "int",
      "default": 16,
      "min": 1,
      "max": 100,
      "modes": [
        "kb"
      ],
      "hosts": [
        "vm"
      ]
    },
    {
      "key": "agent_max_concurrency_per_key",
      "group": "concurrency",
      "label": "Agent 单 Key 最大并发",
      "hint": "0 = 不限（默认）。设限后粘性 Key 繁忙时会话会被分流到其他 Key，导致上游提示词缓存失效",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 1000,
      "modes": [
        "agent"
      ],
      "hosts": [
        "vm"
      ]
    },
    {
      "key": "ocr_max_inflight",
      "group": "concurrency",
      "label": "OCR 全局在途内存并发上限",
      "hint": "防止并发大图 Base64 导致内存爆满，严格限制同时执行的 OCR 请求数",
      "type": "int",
      "default": 12,
      "min": 1,
      "max": 30,
      "modes": [
        "kb"
      ],
      "hosts": [
        "vm"
      ]
    },
    {
      "key": "ocr_queue_timeout_sec",
      "group": "concurrency",
      "label": "OCR 排队超时等待秒数",
      "hint": "超出 OCR 在途并发时，请求在内存队列中等待的最大秒数；设为 0 表示不排队立即 429",
      "type": "int",
      "unit": "s",
      "default": 30,
      "min": 0,
      "max": 300,
      "modes": [
        "kb"
      ],
      "hosts": [
        "vm"
      ]
    },
    {
      "key": "cooldown_quota_sec",
      "group": "fault",
      "label": "欠费/额度耗尽冷却 (秒)",
      "hint": "上游返回余额不足/额度耗尽时该 Key 的冷却时长（与 403 模型级冷却相互独立）",
      "type": "int",
      "default": 1800,
      "min": 10,
      "max": 3600,
      "modes": [
        "agent",
        "kb"
      ],
      "hosts": [
        "vm"
      ]
    },
    {
      "key": "cooldown_404_sec",
      "group": "fault",
      "label": "404 冷却 (秒)",
      "hint": "供应商 404 时的候选 Key 冷却时长",
      "type": "int",
      "default": 600,
      "min": 0,
      "max": 3600,
      "modes": [
        "agent",
        "kb"
      ],
      "hosts": [
        "vm"
      ]
    },
    {
      "key": "cooldown_410_sec",
      "group": "fault",
      "label": "410 模型下线冷却 (秒)",
      "hint": "上游返回 410（模型已下线）时该模型在所有 Key 上的冷却时长",
      "type": "int",
      "default": 86400,
      "min": 60,
      "max": 259200,
      "modes": [
        "agent",
        "kb"
      ],
      "hosts": [
        "vm"
      ]
    },
    {
      "key": "circuit_escalation_sec",
      "group": "fault",
      "label": "KB 熔断升级冷却 (秒)",
      "hint": "KB 模式下连续失败触发熔断时的最小冷却时长（实际取 max(circuit_cooldown_sec, 本值)）",
      "type": "int",
      "default": 1800,
      "min": 60,
      "max": 86400,
      "modes": [
        "kb"
      ],
      "hosts": [
        "vm"
      ]
    },
    {
      "key": "kb_global_max_concurrency",
      "group": "concurrency",
      "label": "KB 全局最大并发",
      "hint": "KB 模式全节点/全 Key 的总并发上限",
      "type": "int",
      "default": 30,
      "min": 1,
      "max": 500,
      "modes": [
        "kb"
      ],
      "hosts": [
        "vm"
      ]
    }
  ]
}
