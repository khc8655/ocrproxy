{
  "version": 1,
  "groups": [
    { "id": "auth", "title": "客户端鉴权与运行模式" },
    { "id": "routing", "title": "路由与负载均衡策略" },
    { "id": "timeout", "title": "超时与预算控制" },
    { "id": "fault", "title": "容错、熔断与冷却" },
    { "id": "concurrency", "title": "并发与队列控制" }
  ],
  "fields": [
    {
      "key": "proxy_api_key",
      "group": "auth",
      "label": "客户端调用 API Key",
      "hint": "外部应用访问 /v1/chat/completions 或 /v1/embeddings 等生产路由时所带的 Bearer Token",
      "type": "string",
      "placeholder": "留空则使用管理员密码作为客户端 Key",
      "modes": ["agent", "kb"],
      "hosts": ["vm", "edgeone"]
    },
    {
      "key": "agent_routing_strategy",
      "group": "routing",
      "label": "智能体 Key 调度策略",
      "hint": "sticky_failover 具备会话粘性且故障自动转移；failover 纯随机故障转移；manual 按添加顺序严格直通",
      "type": "select",
      "default": "sticky_failover",
      "options": [
        { "value": "sticky_failover", "label": "粘性会话与智能故障转移 (推荐)" },
        { "value": "failover", "label": "优先轮询与故障转移" },
        { "value": "manual", "label": "手动严格顺序直通 (不重试)" }
      ],
      "modes": ["agent"],
      "hosts": ["vm", "edgeone"]
    },
    {
      "key": "kb_routing_strategy",
      "group": "routing",
      "label": "KB 知识库调度策略",
      "hint": "round_robin 轮询负载；weighted 加权路由；latency_first 最低延迟优先",
      "type": "select",
      "default": "round_robin",
      "options": [
        { "value": "round_robin", "label": "标准轮询 (Round Robin)" },
        { "value": "weighted", "label": "性能与配额加权轮询" },
        { "value": "latency_first", "label": "最低延迟优先" }
      ],
      "modes": ["kb"],
      "hosts": ["vm"]
    },
    {
      "key": "agent_first_byte_timeout_sec",
      "group": "timeout",
      "label": "智能体首字节等待超时",
      "hint": "单次尝试等待首字节的最长秒数。支持长思考/推理模型（如 DeepSeek-R1、Claude 3.7），建议 ≥ 120s",
      "type": "int",
      "unit": "s",
      "default": 120,
      "min": 5,
      "max": 600,
      "modes": ["agent"],
      "hosts": ["vm", "edgeone"],
      "aliases": ["upstream_timeout_sec", "upstream_timeout_chat"]
    },
    {
      "key": "stream_precommit_grace_sec",
      "group": "timeout",
      "label": "流式首包前静默上限",
      "hint": "流式请求在上游首包前最多静默多少秒（期间仍可换 Key），超过后先回 200 + 心跳。需小于前置代理空闲超时（Nginx 默认 60s）",
      "type": "int",
      "unit": "s",
      "default": 45,
      "min": 1,
      "max": 120,
      "modes": ["agent"],
      "hosts": ["vm"]
    },
    {
      "key": "edge_peek_window_sec",
      "group": "timeout",
      "label": "流式首包前静默上限",
      "hint": "流式请求在上游首包前最多静默多少秒（期间仍可换 Key），超过后先回 200 + 心跳。EdgeOne 与客户端空闲上限约 25s",
      "type": "int",
      "unit": "s",
      "default": 20,
      "min": 3,
      "max": 24,
      "modes": ["agent"],
      "hosts": ["edgeone"]
    },
    {
      "key": "upstream_timeout_sec",
      "group": "timeout",
      "label": "知识库常规请求单次超时",
      "hint": "KB 模式下 Chat/Embedding/Rerank 等常规轻量接口的单次等待超时",
      "type": "int",
      "unit": "s",
      "default": 15,
      "min": 5,
      "max": 300,
      "modes": ["kb"],
      "hosts": ["vm"],
      "aliases": ["chat_fast_timeout", "upstream_timeout_chat", "upstream_timeout_embedding", "upstream_timeout_rerank"]
    },
    {
      "key": "upstream_timeout_kb",
      "group": "timeout",
      "label": "OCR / 异步耗时任务超时",
      "hint": "处理大图 OCR 或高延迟批处理任务的单次等待超时",
      "type": "int",
      "unit": "s",
      "default": 60,
      "min": 10,
      "max": 300,
      "modes": ["kb"],
      "hosts": ["vm"],
      "aliases": ["upstream_timeout_ocr"]
    },
    {
      "key": "request_total_budget_sec",
      "group": "timeout",
      "label": "单请求全局总预算 (可选)",
      "hint": "所有故障转移与重试累计耗时的最终截止预算。留空时系统将按 [单次超时 × 重试次数] 自动计算",
      "type": "int",
      "unit": "s",
      "default": 300,
      "min": 10,
      "max": 900,
      "optional": true,
      "modes": ["agent", "kb"],
      "hosts": ["vm", "edgeone"],
      "aliases": ["schedule_total_budget"]
    },
    {
      "key": "max_retries",
      "group": "fault",
      "label": "单请求最大重试次数",
      "hint": "单个用户请求在上游异常时允许轮换尝试不同 Key 的最大次数",
      "type": "int",
      "default": 3,
      "min": 1,
      "max": 10,
      "modes": ["agent", "kb"],
      "hosts": ["vm", "edgeone"],
      "aliases": ["schedule_total_budget_count"]
    },
    {
      "key": "max_attempts_per_provider",
      "group": "fault",
      "label": "同一供应商最大重试 Key 数",
      "hint": "同一家厂商遭遇连续失败时，最多尝试该厂商名下几个不同的 Key",
      "type": "int",
      "default": 3,
      "min": 1,
      "max": 10,
      "modes": ["agent", "kb"],
      "hosts": ["vm", "edgeone"]
    },
    {
      "key": "fast_failover_provider_down",
      "group": "fault",
      "label": "供应商宕机快速跳过 (502/504/网络超时)",
      "hint": "当同一供应商名下有 Key 遭遇 502/504 或连接超时时，若配置了其他可用厂商，立即跳往下一厂商而不是重试本厂商其他 Key",
      "type": "boolean",
      "default": true,
      "modes": ["agent", "kb"],
      "hosts": ["vm", "edgeone"]
    },
    {
      "key": "cooldown_429_sec",
      "group": "fault",
      "label": "429 速率超限临时冷却",
      "hint": "遭遇上游 429 Too Many Requests (TPM/RPM 超限) 时，将该 Key 移入冷却队列的秒数",
      "type": "int",
      "unit": "s",
      "default": 60,
      "min": 5,
      "max": 600,
      "modes": ["agent", "kb"],
      "hosts": ["vm", "edgeone"],
      "aliases": ["cooldown_tpm_sec"]
    },
    {
      "key": "cooldown_5xx_sec",
      "group": "fault",
      "label": "5xx 服务端错误冷却",
      "hint": "上游返回 500/502/503/504 错误时的临时封锁秒数",
      "type": "int",
      "unit": "s",
      "default": 30,
      "min": 5,
      "max": 300,
      "modes": ["agent", "kb"],
      "hosts": ["vm", "edgeone"],
      "aliases": ["cooldown_duration"]
    },
    {
      "key": "cooldown_403_sec",
      "group": "fault",
      "label": "403/额度耗尽冷却",
      "hint": "上游提示额度不足、欠费或账户封禁时的冷却秒数",
      "type": "int",
      "unit": "s",
      "default": 600,
      "min": 10,
      "max": 3600,
      "modes": ["agent", "kb"],
      "hosts": ["vm", "edgeone"],
      "aliases": ["cooldown_quota_sec"]
    },
    {
      "key": "circuit_break_threshold",
      "group": "fault",
      "label": "连续熔断阈值",
      "hint": "连续遭遇多少次失败后触发该 Key 的熔断隔离",
      "type": "int",
      "default": 3,
      "min": 1,
      "max": 10,
      "modes": ["agent", "kb"],
      "hosts": ["vm", "edgeone"]
    },
    {
      "key": "circuit_cooldown_sec",
      "group": "fault",
      "label": "熔断后恢复探活周期",
      "hint": "Key 触发熔断后保持隔离的秒数，过期后自动进入半开状态试探",
      "type": "int",
      "unit": "s",
      "default": 60,
      "min": 5,
      "max": 600,
      "modes": ["agent", "kb"],
      "hosts": ["vm", "edgeone"]
    },
    {
      "key": "max_concurrency_per_key",
      "group": "concurrency",
      "label": "单 Key 最大并发请求数",
      "hint": "单个 API Key 允许同时处理的最大在途请求数，超出则排队或调度至其他候选 Key",
      "type": "int",
      "default": 5,
      "min": 1,
      "max": 100,
      "modes": ["agent", "kb"],
      "hosts": ["vm"]
    },
    {
      "key": "ocr_max_inflight",
      "group": "concurrency",
      "label": "OCR 全局在途内存并发上限",
      "hint": "防止并发大图 Base64 导致内存爆满，严格限制同时执行的 OCR 请求数",
      "type": "int",
      "default": 6,
      "min": 1,
      "max": 30,
      "modes": ["kb"],
      "hosts": ["vm"]
    },
    {
      "key": "ocr_queue_timeout_sec",
      "group": "concurrency",
      "label": "OCR 排队超时等待秒数",
      "hint": "超出 OCR 在途并发时，请求在内存队列中等待的最大秒数；设为 0 表示不排队立即 429",
      "type": "int",
      "unit": "s",
      "default": 30,
      "min": 0,
      "max": 300,
      "modes": ["kb"],
      "hosts": ["vm"]
    }
  ]
}
