[Unit]
Description=OCRProxy - Unified LLM Proxy Service
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=ocrproxy
Group=ocrproxy
WorkingDirectory=/opt/ocrproxy
EnvironmentFile=/opt/ocrproxy/.env
# MALLOC_ARENA_MAX=2: glibc ptmalloc2 creates up to 8×cores arenas by default,
# each holding freed memory that is never returned to the OS.  For a single-
# worker async server this causes RSS to grow monotonically under large
# payloads (e.g. OCR base64 images).  Capping to 2 arenas eliminates the
# fragmentation at the source — no need to limit request body size.
Environment=MALLOC_ARENA_MAX=2
ExecStart=/opt/ocrproxy/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8787 --workers 1 --timeout-keep-alive 30 --timeout-graceful-shutdown 10
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Memory limits (system has 1.6 GB total).
# MemoryHigh=768M gives enough headroom for OCR base64 payloads while still
# triggering kernel reclaim pressure before OOM.  MemoryMax=1024M is the hard
# ceiling — the process gets killed rather than the whole machine OOMing.
MemoryHigh=768M
MemoryMax=1024M
MemorySwapMax=0

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ocrproxy/config
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
