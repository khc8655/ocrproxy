# ============================================================
# Caddy 配置示例 — 网站与 OCRProxy 完全分离
#
# 端口 80：个人主页（纯静态，备案要求）
# 端口 9090：OCRProxy API 代理（独立服务）
# ============================================================

# ── 端口 80：个人主页（纯静态）─────────────────────────────
:80 {
    root * /var/www/ocrproxy

    file_server {
        browse false
    }
    try_files {path} /index.html

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        X-XSS-Protection "1; mode=block"
        Server ""
    }

    log {
        output file /var/log/caddy/site.log {
            roll_size 10MB
            roll_keep 3
        }
        format json
    }
}

# ── 端口 9090：OCRProxy API 代理 ───────────────────────────
:9090 {
    reverse_proxy 127.0.0.1:8787 {
        flush_interval -1
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Server ""
    }

    log {
        output file /var/log/caddy/ocrproxy.log {
            roll_size 10MB
            roll_keep 3
        }
        format json
    }
}

# ============================================================
# EdgeOne 场景：EdgeOne 处理 HTTPS，回源到本机
# - 主域名 → 回源到 80 端口（静态首页）
# - API 域名/路径 → 回源到 9090 端口（OCRProxy）
# ============================================================

# ============================================================
# 直连 HTTPS 场景：域名直接解析到本机
# 取消注释并替换 your-domain.com
# ============================================================

# your-domain.com {
#     root * /var/www/ocrproxy
#     file_server { browse false }
#     try_files {path} /index.html
# }
#
# api.your-domain.com {
#     reverse_proxy 127.0.0.1:8787 {
#         flush_interval -1
#     }
# }
