# ============================================================
# Caddy 配置示例 — 网站与 OCRProxy 完全分离
#
# 端口 80：个人主页（纯静态，备案要求）
# 端口 9090：OCRProxy API 代理（独立服务）
# ============================================================

# ── 端口 80：个人主页（纯静态）─────────────────────────────
:80 {
    root * /var/www/ocrproxy

    file_server {
        browse false
    }
    try_files {path} /index.html

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        X-XSS-Protection "1; mode=block"
        Server ""
    }

    log {
        output file /var/log/caddy/site.log {
            roll_size 10MB
            roll_keep 3
        }
        format json
    }
}

# ── 端口 9090：OCRProxy API 代理 ───────────────────────────
# ⚠ 安全提示：此站点当前为明文 HTTP。经 http://IP:9090 直连时，
# PROXY_API_KEY / ADMIN_PASSWORD 会以明文穿越公网。建议任选其一：
#   1. 绑定域名启用 TLS（参考本文件底部的直连 HTTPS 场景）；
#   2. 腾讯云安全组将 9090 限制到你自己的出口 IP；
#   3. 全部流量走 EdgeOne HTTPS 回源。
:9090 {
    # 限制请求体大小：OCR base64 通常 <10MB，25MB 已留足余量。
    # 在解析进 Python 堆之前就拒绝超大请求，保护 1.6GB 小内存 VM。
    request_body {
        max_size 25MB
    }

    reverse_proxy 127.0.0.1:8787 {
        flush_interval -1
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Server ""
    }

    log {
        output file /var/log/caddy/ocrproxy.log {
            roll_size 10MB
            roll_keep 3
        }
        format json
    }
}

# ============================================================
# EdgeOne 场景：EdgeOne 处理 HTTPS，回源到本机
# - 主域名 → 回源到 80 端口（静态首页）
# - API 域名/路径 → 回源到 9090 端口（OCRProxy）
# ============================================================

# ============================================================
# 直连 HTTPS 场景：域名直接解析到本机
# 取消注释并替换 your-domain.com
# ============================================================

# your-domain.com {
#     root * /var/www/ocrproxy
#     file_server { browse false }
#     try_files {path} /index.html
# }
#
# api.your-domain.com {
#     reverse_proxy 127.0.0.1:8787 {
#         flush_interval -1
#     }
# }
