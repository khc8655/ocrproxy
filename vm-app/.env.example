# ocrproxy 环境变量配置
# 此文件包含敏感密钥，权限应设置为 600 (仅所有者可读写)
# 安装脚本会自动生成此文件

# 代理服务监听地址 (仅本地监听，由 Caddy 反向代理)
APP_HOST=127.0.0.1
APP_PORT=8787

# 代理 API Key - 客户端调用 /v1/* 接口时使用的密钥
PROXY_API_KEY=change-me-to-a-random-string

# 管理员密码 - 登录后台管理面板使用的密码
ADMIN_PASSWORD=change-me-to-another-random-string

# 配置文件加密密钥 (Fernet key) - 用于加密存储 proxy_config.enc
# 通过 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成
ENCRYPT_KEY=change-me-to-a-fernet-key

# 配置文件存储目录
CONFIG_DIR=/opt/ocrproxy/config
